---
import Base from '@/layouts/Base.astro';
import { site } from '@/config';

const analyticsOn = Boolean(site.analytics.goatcounter);
---

<Base
  title="Privacy"
  description="How this academic website handles visitor data: no cookies, self-hosted assets, cookieless statistics and lazily loaded citation badges."
>
  <div class="prose">
    <h1>Privacy</h1>
    <p>
      This is the personal academic website of Dr. Pavlo Radiuk. It does not use cookies, has no
      sign-in, and serves its fonts, icons and maps from this site rather than from third parties.
    </p>

    <h2>Hosting</h2>
    <p>
      The site is hosted on GitHub Pages, operated by GitHub, Inc. To deliver and secure the
      service, GitHub may log technical data such as your IP address. See the
      <a
        href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement"
        >GitHub General Privacy Statement</a
      >.
    </p>

    {analyticsOn && (
      <>
        <h2>Visitor statistics</h2>
        <p>
          Visits are counted with <a href="https://www.goatcounter.com">GoatCounter</a>, which sets
          no cookies and stores nothing in your browser. It does not store IP addresses or the full
          browser identification string. Your IP address is used only to derive a coarse location
          and, together with the browser string, to avoid counting a repeat visit; that link is held
          in memory for at most eight hours. Only aggregate counts are kept: page, referrer,
          browser, operating system, screen width, location and language. See the
          <a href="https://www.goatcounter.com/help/privacy">GoatCounter privacy policy</a>.
        </p>
      </>
    )}

    <h2>Citation badges</h2>
    <p>
      Publication lists show citation counts from <a href="https://www.dimensions.ai">Dimensions</a>
      (Digital Science). The badge script loads from <code>badge.dimensions.ai</code> only when a
      badge scrolls into view. Your browser then contacts Dimensions' servers, which receive your IP
      address and browser information. When tested in October 2026, the badges set no cookies. See
      the <a href="https://www.dimensions.ai/policies/privacy/">Dimensions privacy policy</a>.
    </p>

    <h2>External links</h2>
    <p>
      Links to publishers, DOIs and research profiles lead to other websites with their own privacy
      policies.
    </p>

    <p class="updated">Last updated: 19 October 2026.</p>
  </div>
</Base>

<style>
  .prose {
    max-width: var(--measure);
    margin-inline: auto;
    padding: var(--space-8) var(--gutter);
    display: grid;
    gap: var(--space-4);
  }
  h1 {
    font-size: var(--text-3xl);
  }
  h2 {
    margin-top: var(--space-4);
    font-size: var(--text-xl);
  }
  .updated {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
</style>
