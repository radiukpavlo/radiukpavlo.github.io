---
// Toolchain smoke test: fonts, tokens, icons and theme toggle. Replaced in the build phase.
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import EuropeMap from '@/components/EuropeMap.astro';
import DimensionsBadge from '@/components/DimensionsBadge.astro';

// Sample venues from the CV knowledge base; the real list comes from talks data later.
const venues = [
  { name: 'Khmelnytskyi (home institution)', lon: 26.99, lat: 49.42, home: true },
  { name: 'Dortmund', lon: 7.47, lat: 51.51 },
  { name: 'Gliwice', lon: 18.67, lat: 50.29 },
  { name: 'Växjö', lon: 14.81, lat: 56.88 },
  { name: 'Lyon', lon: 4.84, lat: 45.76 },
  { name: 'Bratislava', lon: 17.11, lat: 48.15 },
  { name: 'Athens', lon: 23.73, lat: 37.98 },
  { name: 'Odesa', lon: 30.72, lat: 46.48 },
  { name: 'Dresden', lon: 13.74, lat: 51.05 },
  { name: "L'Aquila", lon: 13.4, lat: 42.35 },
];

const links = [
  { icon: 'academicons:google-scholar', label: 'Google Scholar' },
  { icon: 'academicons:orcid', label: 'ORCID' },
  { icon: 'academicons:scopus', label: 'Scopus' },
  { icon: 'academicons:clarivate', label: 'Web of Science' },
  { icon: 'simple-icons:linkedin', label: 'LinkedIn' },
  { icon: 'academicons:researchgate', label: 'ResearchGate' },
  { icon: 'simple-icons:github', label: 'GitHub' },
];
---

<Base title="Dr. Pavlo Radiuk — toolchain check">
  <main class="wrap">
    <p class="eyebrow">Explainable AI · Associate Professor · Khmelnytskyi National University</p>
    <h1>Dr. Pavlo Radiuk</h1>
    <p class="lede">Explainable AI that experts can audit.</p>
    <p>
      Body text in Inter at 17&nbsp;px. Headings in Fraunces with optical sizing. Links use the
      <a href="#">accessible copper</a>; labels use the decorative copper.
    </p>
    <ul class="links" aria-label="Profiles">
      {links.map((l) => <li>
        <Icon name={l.icon} label={l.label} size="1.5em" />
      </li>)}
    </ul>
    <article class="card">
      <span class="label">Journal · 2026</span>
      <h2>Transition matrices for auditable explanations</h2>
      <p class="muted">P. Radiuk, O. Barmak, …</p>
      <pre><code>@article&#123;radiuk2026example, doi = &#123;10.0000/example&#125;&#125;</code></pre>
      <DimensionsBadge doi="10.3390/drones9110743" />
    </article>
    <p class="muted">Citation data: <a href="https://www.dimensions.ai">Dimensions</a>.</p>
    <EuropeMap pins={venues} title="Where my work was presented" />
    <button type="button" id="theme-toggle" aria-label="Toggle dark mode">
      <Icon name="lucide:sun-moon" /> Toggle theme
    </button>
  </main>
</Base>

<script>
  const root = document.documentElement;
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const dark =
      root.dataset.theme === 'dark' ||
      (!root.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
    const next = dark ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });
</script>

<style>
  .wrap {
    max-width: var(--measure);
    margin-inline: auto;
    padding: var(--space-8) var(--gutter);
    display: grid;
    gap: var(--space-5);
  }
  .eyebrow {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  h1 {
    font-size: var(--text-display);
  }
  .lede {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-style: italic;
    color: var(--color-accent);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    padding: 0;
    list-style: none;
    color: var(--color-text);
  }
  .card {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-5);
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
  }
  .card h2 {
    font-size: var(--text-xl);
  }
  .label {
    justify-self: start;
    padding: 0.15em 0.6em;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-accent-text);
    background: var(--color-accent-soft);
    border-radius: var(--radius-pill);
  }
  .muted {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
  pre {
    overflow-x: auto;
    padding: var(--space-3);
    background: var(--color-surface-2);
    border-radius: var(--radius-md);
  }
  button {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    background: transparent;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-pill);
    cursor: pointer;
  }
</style>
