---
/** Static, themable SVG map of Europe with venue pins, rendered entirely at build time. */
import { buildEuropeMap, type MapPin } from '@/lib/europe-map';

interface Props {
  pins: MapPin[];
  title: string;
}

const { pins, title } = Astro.props;
const map = buildEuropeMap(pins);
const id = `map-${Math.random().toString(36).slice(2, 8)}`;
---

<figure class="europe-map">
  <svg viewBox={`0 0 ${map.width} ${map.height}`} role="img" aria-labelledby={id}>
    <title id={id}>{title}</title>
    <path class="graticule" d={map.graticule}></path>
    <path class="land" d={map.land}></path>
    <path class="ukraine" d={map.ukraine}></path>
    <path class="borders" d={map.borders}></path>
    {map.pins.map((p) => <g
      class:list={['pin', { home: p.home }]}
      transform={`translate(${p.x} ${p.y})`}
    >
      <title>{p.name}</title>
      <circle r={p.home ? 7 : 5.5} />
    </g>)}
  </svg>
  <figcaption class="sr-only">
    <ul>
      {pins.map((p) => <li>{p.name}</li>)}
    </ul>
  </figcaption>
</figure>

<style>
  .europe-map svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .graticule {
    fill: none;
    stroke: var(--color-rule);
    stroke-width: 0.5;
  }
  .land {
    fill: var(--color-surface-2);
  }
  .ukraine {
    fill: var(--color-accent-soft);
  }
  .borders {
    fill: none;
    stroke: var(--color-bg);
    stroke-width: 0.8;
    stroke-linejoin: round;
  }
  .pin circle {
    fill: var(--color-accent);
    stroke: var(--color-bg);
    stroke-width: 2;
  }
  .pin.home circle {
    fill: var(--color-text);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
