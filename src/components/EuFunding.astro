---
/**
 * Horizon Europe visibility: the official "Funded by the European Union" emblem (positive on
 * light, negative on dark) with the project's disclaimer. The emblem is never modified.
 */
import { Image } from 'astro:assets';
import neg from '@/assets/eu/eu-funded-neg.png';
import pos from '@/assets/eu/eu-funded-pos.png';

interface Props {
  disclaimer: string;
}

const { disclaimer } = Astro.props;
---

<figure class="eu-funding">
  <Image class="only-light" src={pos} alt="Funded by the European Union" width={240} />
  <Image class="only-dark" src={neg} alt="Funded by the European Union" width={240} />
  <figcaption>{disclaimer}</figcaption>
</figure>

<style>
  .eu-funding {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
    padding-block: var(--space-4);
  }

  .eu-funding :global(img) {
    inline-size: 15rem;
    height: auto;
  }

  figcaption {
    max-width: var(--measure);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
</style>
