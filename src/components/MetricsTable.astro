---
/**
 * Citation metrics by database, each with the date it was read. Used on the Publications page;
 * counts are never added across databases.
 */
import { formatDate, formatNumber } from '@/lib/format';
import { getMetrics } from '@/lib/profile';

const m = await getMetrics();
const rows = [
  {
    source: 'Google Scholar',
    documents: '—',
    citations: formatNumber(m.scholar.citations),
    h: m.scholar.h,
    asOf: formatDate(m.scholar.asOf),
  },
  {
    source: 'Scopus',
    documents: String(m.scopus.documents),
    citations: formatNumber(m.scopus.citations),
    h: m.scopus.h,
    asOf: formatDate(m.scopus.asOf),
  },
  {
    source: 'Web of Science Core Collection',
    documents: String(m.wos.documents),
    citations: formatNumber(m.wos.citations),
    h: m.wos.h,
    asOf: formatDate(m.wos.asOf),
  },
];
---

<table class="metrics sans">
  <caption>
    Citation metrics by database (not summed across sources)
  </caption>
  <thead>
    <tr>
      <th scope="col">Source</th>
      <th scope="col">Documents</th>
      <th scope="col">Citations</th>
      <th scope="col"><abbr title="h-index">h</abbr></th>
      <th scope="col">As of</th>
    </tr>
  </thead>
  <tbody>
    {rows.map((r) => <tr>
      <th scope="row">{r.source}</th>
      <td>{r.documents}</td>
      <td>{r.citations}</td>
      <td>{r.h}</td>
      <td>{r.asOf}</td>
    </tr>)}
  </tbody>
</table>

<style>
  .metrics {
    inline-size: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
  }

  caption {
    caption-side: bottom;
    padding-block-start: var(--space-2);
    text-align: start;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  th,
  td {
    padding: var(--space-2) var(--space-3) var(--space-2) 0;
    text-align: start;
    border-bottom: 1px solid var(--color-rule);
  }

  thead th {
    font-weight: 600;
    color: var(--color-text-muted);
  }

  tbody th {
    font-weight: 600;
  }
</style>
